@model ST10482636_EventEase.Models.Event

@{
    ViewData["Title"] = "Edit Event";
}

<div class="action-header">
    <h1>Modify Event Details</h1>
    <p class="action-subtitle">Update fields below to adjust schedules or categories.</p>
</div>

<div class="container form-card-container">
    <div class="form-card">

        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="EventId" />
            <input type="hidden" asp-for="ImageUrl" />

            <div class="form-group mb-4">
                <label asp-for="EventName" class="control-label custom-label">Event Title</label>
                <input asp-for="EventName" class="form-control custom-input" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="EventTypeId" class="control-label custom-label">Event Category Type</label>
                <select asp-for="EventTypeId" class="form-control custom-input" asp-items="ViewBag.EventTypeId">
                    <option value="">-- Select a Category --</option>
                </select>
                <span asp-validation-for="EventTypeId" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Description" class="control-label custom-label">Description</label>
                <textarea asp-for="Description" class="form-control custom-input" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="EventDate" class="control-label custom-label">Scheduled Date</label>
                <input asp-for="EventDate" class="form-control custom-input" type="date" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-3">
                    <label class="custom-label">Current Active Banner</label>
                    <div class="mt-2">
                        <img src="@Model.ImageUrl" style="max-width: 200px; border-radius: 6px; border: 1px solid #eaeaea;" />
                    </div>
                </div>
            }

            <div class="form-group mb-5">
                <label asp-for="ImageFile" class="control-label custom-label">Replace Banner Image (Optional)</label>
                <input asp-for="ImageFile" type="file" class="form-control custom-input" accept="image/*" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <div class="form-group form-actions">
                <a asp-action="Index" class="btn-minimal btn-back" style="text-decoration: none; line-height: 40px; text-align: center;">Cancel</a>
                <input type="submit" value="Save Changes" class="btn-cta btn-submit" />
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}