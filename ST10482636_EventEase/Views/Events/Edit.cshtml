@model ST10482636_EventEase.Models.Event

@{
    ViewData["Title"] = "Edit Event";
}

<div class="action-header">
    <h1>Edit Event</h1>
    <p class="action-subtitle">Update your scheduled event details.</p>
</div>

<div class="container form-card-container">
    <div class="form-card">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="EventId" />

            <div class="form-group mb-4">
                <label asp-for="EventName" class="control-label custom-label"></label>
                <input asp-for="EventName" class="form-control custom-input" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Description" class="control-label custom-label"></label>
                <textarea asp-for="Description" class="form-control custom-input" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-5">
                <label asp-for="EventDate" class="control-label custom-label"></label>
                <input asp-for="EventDate" class="form-control custom-input" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-3">
                    <p>Current Banner:</p>
                    <img src="@Model.ImageUrl" style="max-width: 200px; border-radius: 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);" />
                </div>
            }

            <div class="form-group form-actions">
                <a asp-action="Index" class="btn-minimal btn-back">Back to List</a>
                <input type="submit" value="Save Changes" class="btn-cta btn-submit" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}