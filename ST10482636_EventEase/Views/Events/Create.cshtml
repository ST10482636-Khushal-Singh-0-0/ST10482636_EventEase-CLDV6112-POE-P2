@model ST10482636_EventEase.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

<div class="action-header">
    <h1>Create New Event</h1>
    <p class="action-subtitle">Fill in the details below to schedule your next event.</p>
</div>

<div class="container form-card-container">
    <div class="form-card">

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-4">
                <label asp-for="EventName" class="control-label custom-label"></label>
                <input asp-for="EventName" class="form-control custom-input" placeholder="e.g., Summer Music Festival" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Description" class="control-label custom-label"></label>
                <textarea asp-for="Description" class="form-control custom-input" rows="3" placeholder="Describe what the event is about..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-5">
                <label asp-for="EventDate" class="control-label custom-label"></label>
                <input asp-for="EventDate" class="form-control custom-input" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>

            <div class="form-group form-actions">
                <a asp-action="Index" class="btn-minimal btn-back">Back to List</a>
                <input type="submit" value="Create Event" class="btn-cta btn-submit" />
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}