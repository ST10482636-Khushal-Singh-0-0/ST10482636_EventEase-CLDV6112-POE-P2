@model ST10482636_EventEase.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="action-header">
    <h1>Event Details</h1>
    <p class="action-subtitle">Review the scheduled event information.</p>
</div>

<div class="container form-card-container">
    <div class="form-card">
        <h3 class="card-title-display">@Model.EventName</h3>

        <dl class="row dl-layout">
            <dt class="col-sm-4 dt-label">Date & Time</dt>
            <dd class="col-sm-8">@Model.EventDate.ToString("dd MMM yyyy, HH:mm")</dd>

            <dt class="col-sm-4 dt-label">Description</dt>
            <dd class="col-sm-8">@Model.Description</dd>
        </dl>

        <div class="form-actions">
            <a asp-action="Index" class="btn-minimal btn-back">Back to List</a>
            <a asp-action="Edit" asp-route-id="@Model.EventId" class="btn-cta btn-submit">Edit Event</a>
        </div>
    </div>
</div>