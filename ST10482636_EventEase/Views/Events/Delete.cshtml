@model ST10482636_EventEase.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<div class="action-header">
    <h1>Delete Event</h1>
    <p class="action-subtitle-danger">Are you sure you want to delete this event?</p>
</div>

<div class="container form-card-container">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-banner">
            ⚠️ @TempData["ErrorMessage"]
        </div>
    }

    <div class="form-card">
        <h3 class="card-title-display">@Model.EventName</h3>

        <dl class="row dl-layout">
            <dt class="col-sm-4 dt-label">Date</dt>
            <dd class="col-sm-8">@Model.EventDate.ToString("dd MMM yyyy, HH:mm")</dd>

            <dt class="col-sm-4 dt-label">Description</dt>
            <dd class="col-sm-8">@Model.Description</dd>
        </dl>

        <form asp-action="Delete" class="form-actions">
            <input type="hidden" asp-for="EventId" />
            <a asp-action="Index" class="btn-minimal btn-back">Cancel</a>
            <input type="submit" value="Delete Permanently" class="btn-danger-submit" />
        </form>
    </div>
</div>