<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EventEase — @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="container header-grid">
            <a asp-controller="Home" asp-action="Index" class="logo">
                <strong>EVENT</strong>EASE
            </a>

            <nav class="nav-links">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Venues" asp-action="Index">Venues</a>
                <a asp-controller="Events" asp-action="Index">Events</a>
                <a asp-controller="Bookings" asp-action="Index">Bookings</a>
            </nav>

            <div class="header-spacer"></div>
        </div>
    </header>

    <div class="container main-content">
        <main role="main" class="pb-3">
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin-bottom: 20px; padding: 15px; background-color: #d4edda; color: #155724; border-radius: 5px; border: 1px solid #c3e6cb;">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="float:right; background:none; border:none; font-size:1.2em; cursor:pointer;">&times;</button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert" style="margin-bottom: 20px; padding: 15px; background-color: #f8d7da; color: #721c24; border-radius: 5px; border: 1px solid #f5c6cb;">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="float:right; background:none; border:none; font-size:1.2em; cursor:pointer;">&times;</button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="fixed-footer">
        <div class="container footer-grid">
            <div class="footer-info">
                Khushal Singh <strong>ST10482636</strong>
            </div>

            <nav class="footer-links">
                <a asp-controller="Venues" asp-action="Index">Venues</a>
                <a asp-controller="Events" asp-action="Index">Events</a>
                <a asp-controller="Bookings" asp-action="Index">Bookings</a>
            </nav>

            <div class="footer-tag">
                @DateTime.Now.Year — VC, Emeris
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>