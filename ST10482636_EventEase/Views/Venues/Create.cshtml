@model ST10482636_EventEase.Models.Venue

@{
    ViewData["Title"] = "Create Venue";
}

<div class="action-header">
    <h1>Create New Venue</h1>
    <p class="action-subtitle">Add a new premium space to your platform.</p>
</div>

<div class="container form-card-container">
    <div class="form-card">

        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-4">
                <label asp-for="Name" class="control-label custom-label"></label>
                <input asp-for="Name" class="form-control custom-input" placeholder="e.g., The Grand Hall" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Location" class="control-label custom-label"></label>
                <input asp-for="Location" class="form-control custom-input" placeholder="e.g., Sandton, Johannesburg" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Capacity" class="control-label custom-label"></label>
                <input asp-for="Capacity" class="form-control custom-input" placeholder="e.g., 500" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>

            <div class="form-group mb-5">
                <label asp-for="ImageFile" class="control-label custom-label">Upload Venue Image</label>
                <input asp-for="ImageFile" type="file" class="form-control custom-file-input" accept="image/*" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <div class="form-group form-actions">
                <a asp-action="Index" class="btn-minimal btn-back">Back to List</a>
                <input type="submit" value="Create Venue" class="btn-cta btn-submit" />
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}