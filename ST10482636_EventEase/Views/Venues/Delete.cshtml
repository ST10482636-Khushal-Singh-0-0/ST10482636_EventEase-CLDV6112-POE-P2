@model ST10482636_EventEase.Models.Venue

@{
    ViewData["Title"] = "Delete Venue";
}

<div class="action-header">
    <h1>Delete Venue</h1>
    <p class="action-subtitle-danger">Are you sure you want to delete this venue?</p>
</div>

<div class="container form-card-container">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-banner">
            ⚠️ @TempData["ErrorMessage"]
        </div>
    }

    <div class="form-card">

        <h3 class="card-title-display">@Model.Name</h3>

        <dl class="row dl-layout">
            <dt class="col-sm-4 dt-label">Location</dt>
            <dd class="col-sm-8">@Model.Location</dd>

            <dt class="col-sm-4 dt-label">Capacity</dt>
            <dd class="col-sm-8">@Model.Capacity guests</dd>
        </dl>

        <form asp-action="Delete" class="form-actions">
            <input type="hidden" asp-for="VenueId" />
            <a asp-action="Index" class="btn-minimal btn-back">Cancel</a>
            <input type="submit" value="Delete Permanently" class="btn-danger-submit" />
        </form>

    </div>
</div>