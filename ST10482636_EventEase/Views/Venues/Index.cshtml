@model IEnumerable<ST10482636_EventEase.Models.Venue>

@{
    ViewData["Title"] = "Venues";
}

<div class="action-header">
    <h1>Venues</h1>
    <p>
        <a asp-action="Create" class="btn-minimal">Create New Venue</a>
    </p>

    <form asp-action="Index" method="get" class="search-container">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="search-input" placeholder="Search by venue name or location..." />
        <button type="submit" class="btn-minimal">SEARCH</button>
    </form>
</div>

<div class="venue-grid">
    @foreach (var item in Model)
    {
        <div class="venue-card">

            <div class="venue-card-img-container">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Name" class="venue-card-img" />
                }
                else
                {
                    <span class="venue-no-img">No Image Uploaded</span>
                }
            </div>

            <div class="venue-card-body">
                <h3 class="venue-card-title">@item.Name</h3>

                <div class="venue-card-details">
                    <strong>Location:</strong> @item.Location <br />
                    <strong>Capacity:</strong> @item.Capacity guests
                </div>

                <div class="venue-card-actions">
                    <a asp-action="Edit" asp-route-id="@item.VenueId" class="btn-card-action">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.VenueId" class="btn-card-action">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.VenueId" class="btn-card-action">Delete</a>
                </div>
            </div>

        </div>
    }
</div>