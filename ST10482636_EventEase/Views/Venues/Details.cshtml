@model ST10482636_EventEase.Models.Venue

@{
    ViewData["Title"] = "Venue Details";
}

<div class="action-header">
    <h1>Venue Details</h1>
    <p class="action-subtitle">Review the premium space information.</p>
</div>

<div class="container form-card-container">
    <div class="form-card form-card-image-layout">

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="form-card-image-wrapper">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="form-card-image" />
            </div>
        }

        <div class="form-card-body">
            <h3 class="card-title-display">@Model.Name</h3>

            <dl class="row dl-layout">
                <dt class="col-sm-4 dt-label">Location</dt>
                <dd class="col-sm-8">@Model.Location</dd>

                <dt class="col-sm-4 dt-label">Capacity</dt>
                <dd class="col-sm-8">@Model.Capacity guests</dd>
            </dl>

            <div class="form-actions">
                <a asp-action="Index" class="btn-minimal btn-back">Back to List</a>
                <a asp-action="Edit" asp-route-id="@Model.VenueId" class="btn-cta btn-submit">Edit Venue</a>
            </div>
        </div>
    </div>
</div>