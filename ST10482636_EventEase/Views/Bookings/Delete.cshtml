@model ST10482636_EventEase.Models.Booking

@{
    ViewData["Title"] = "Cancel Booking";
}

<div class="action-header">
    <h1>Cancel Booking</h1>
    <p class="action-subtitle-danger">Are you sure you want to cancel this reservation?</p>
</div>

<div class="container form-card-container">

    <div class="form-card">
        <h3 class="card-title-display">@(Model.Event != null ? Model.Event.EventName : "N/A")</h3>

        <dl class="row dl-layout">
            <dt class="col-sm-4 dt-label">Booking Date</dt>
            <dd class="col-sm-8">@Model.BookingDate.ToString("dd MMM yyyy, HH:mm")</dd>

            <dt class="col-sm-4 dt-label">Venue</dt>
            <dd class="col-sm-8">@(Model.Venue != null ? Model.Venue.Name : "N/A")</dd>

            <dt class="col-sm-4 dt-label">Location</dt>
            <dd class="col-sm-8">@(Model.Venue != null ? Model.Venue.Location : "N/A")</dd>
        </dl>

        <form asp-action="Delete" class="form-actions">
            <input type="hidden" asp-for="BookingId" />
            <a asp-action="Index" class="btn-minimal btn-back">Keep Booking</a>
            <input type="submit" value="Cancel Booking" class="btn-danger-submit" />
        </form>
    </div>
</div>