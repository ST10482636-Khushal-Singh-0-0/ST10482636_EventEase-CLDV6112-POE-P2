@model IEnumerable<ST10482636_EventEase.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<div class="action-header">
    <h1>Reservations Matrix</h1>
    <p>
        <a asp-action="Create" class="btn-minimal">Create New Booking Entry</a>
    </p>
</div>

<div class="venue-grid" style="margin-top: 30px;">
    @foreach (var item in Model)
    {
        <div class="venue-card">
            <div class="venue-card-img-container">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="Booking Banner" class="venue-card-img" />
                }
                else
                {
                    <span class="venue-no-img">No Schedule Banner Associated</span>
                }
            </div>

            <div class="venue-card-body">
                <h3 class="venue-card-title">@(item.Event?.EventName ?? "Unassigned Event Context")</h3>

                <div class="venue-card-details">
                    <strong>Allocated Location Space:</strong> @(item.Venue?.Name ?? "Unassigned Spatial Location") <br />
                    <strong>Schedule Execution Date:</strong> @item.BookingDate.ToString("MMMM dd, yyyy")
                </div>

                <div class="venue-card-actions">
                    <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn-card-action">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.BookingId" class="btn-card-action">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn-card-action">Delete</a>
                </div>
            </div>
        </div>
    }
</div>