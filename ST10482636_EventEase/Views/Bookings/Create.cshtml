@model ST10482636_EventEase.Models.Booking

@{
    ViewData["Title"] = "Make a Booking";
}

<div class="action-header">
    <h1>Make a Booking</h1>
    <p class="action-subtitle">Secure a premium venue for your upcoming event.</p>
</div>

<div class="container form-card-container">
    <div class="form-card">

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-4">
                <label asp-for="VenueId" class="control-label custom-label">Select Venue</label>
                <select asp-for="VenueId" class="form-control custom-input" asp-items="ViewBag.VenueId" style="cursor: pointer;"></select>
            </div>

            <div class="form-group mb-4">
                <label asp-for="EventId" class="control-label custom-label">Select Event</label>
                <select asp-for="EventId" class="form-control custom-input" asp-items="ViewBag.EventId" style="cursor: pointer;"></select>
            </div>

            <div class="form-group mb-5">
                <label asp-for="BookingDate" class="control-label custom-label">Date & Time of Booking</label>
                <input asp-for="BookingDate" class="form-control custom-input" />
                <span asp-validation-for="BookingDate" class="text-danger"></span>
            </div>

            <div class="form-group form-actions">
                <a asp-action="Index" class="btn-minimal btn-back">Back to List</a>
                <input type="submit" value="Confirm Booking" class="btn-cta btn-submit" />
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}